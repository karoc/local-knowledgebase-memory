{
  "id": "openclaw-knowledgebase-local-mysql",
  "name": "知识库插件 (本地 MySQL)",
  "description": "基于自建 MySQL + Ollama 的知识库 RAG 插件",
  "configSchema": {
    "type": "object",
    "required": [
      "mysql",
      "ollama",
      "defaultTable"
    ],
    "properties": {
      "mysql": {
        "type": "object",
        "required": [
          "host",
          "port",
          "user",
          "password",
          "database"
        ],
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "number",
            "default": 3306
          },
          "user": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "database": {
            "type": "string"
          }
        }
      },
      "ollama": {
        "type": "object",
        "required": [
          "baseUrl",
          "model",
          "dimensions"
        ],
        "properties": {
          "baseUrl": {
            "type": "string",
            "default": "http://localhost:11434"
          },
          "model": {
            "type": "string",
            "default": "nomic-embed-text"
          },
          "dimensions": {
            "type": "number",
            "default": 768
          }
        }
      },
      "chunking": {
        "type": "object",
        "required": [
          "strategy",
          "maxChunkSize",
          "overlap"
        ],
        "properties": {
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "const": "paragraph"
              },
              {
                "type": "string",
                "const": "fixed"
              },
              {
                "type": "string",
                "const": "none"
              }
            ]
          },
          "maxChunkSize": {
            "type": "number",
            "default": 500
          },
          "overlap": {
            "type": "number",
            "default": 100
          }
        }
      },
      "defaultTable": {
        "type": "string",
        "default": "default"
      }
    }
  },
  "version": "1.0.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "kb_store",
      "kb_store_batch",
      "kb_search",
      "kb_scan"
    ]
  }
}
